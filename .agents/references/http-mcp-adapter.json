{
  "schema_version": "onion_skill_http_mcp_adapter_v3",
  "deployment_status": {
    "production": "v3_deployed_and_real_e2e_passed",
    "source": "content_automation_0147ed18316cbf388710edda2d2c741eed627182"
  },
  "policy": {
    "skills_are_business_authority": true,
    "adapter_is_replaceable": true,
    "allow_additional_tools": true,
    "missing_required_fact": "stop",
    "business_reads_forbid_direct_database_ssh_or_object_storage": true,
    "provider_keys_are_server_side_only": true,
    "paid_generation_requires_current_task_approval_and_idempotency": true
  },
  "assignment": {
    "oauth_connection": "one_per_person_per_codex_client",
    "all_roles_share_same_scopes": true,
    "role_difference_is_skills_only": true,
    "scope_is_enforced_by_server": true
  },
  "server": {
    "name": "onion-agent",
    "transport": "streamable_http",
    "url": "https://intel-mcp.guanghexinzhi.cn/agent/mcp",
    "auth": "oauth_2_1_authorization_code_pkce",
    "contract_versions": {
      "intelligence": "intelligence_mcp_v3",
      "materials": "materials_mcp_v2"
    },
    "required_scopes": [
      "intelligence:external:read",
      "intelligence:internal-performance:read",
      "materials:read",
      "generation:use"
    ],
    "tools": [
      "intelligence_list_report_availability",
      "intelligence_get_report_scope",
      "intelligence_list_demand_evidence",
      "intelligence_list_creative_evidence",
      "intelligence_search_objects",
      "intelligence_find_similar_objects",
      "intelligence_get_material_detail",
      "intelligence_get_analysis_evidence",
      "intelligence_query_internal_performance",
      "intelligence_list_internal_material_evidence",
      "intelligence_list_internal_complete_material_pool",
      "intelligence_search_internal_objects",
      "intelligence_freeze_report_input",
      "materials_search_speech_masters",
      "materials_search_segments",
      "materials_get_segments",
      "materials_get_speech_master",
      "materials_prepare_sources",
      "generation_upload_media",
      "generation_kimi_generate",
      "generation_kie_image",
      "generation_prepare_image_delivery",
      "generation_moss_tts",
      "generation_qwen_asr",
      "generation_render_voiceover_video",
      "generation_render_talking_head_video",
      "generation_get_operation",
      "generation_get_output"
    ]
  },
  "generation_contract": {
    "approval_field": "approved_in_current_task",
    "idempotency_field": "idempotency_key",
    "generation_context_fields": [
      "task_id",
      "task_version",
      "batch_id",
      "logical_item_id",
      "authorized_item_count",
      "item_index"
    ],
    "retry_reuses_same_key": true,
    "retry_scope": "failed_logical_item_only",
    "max_provider_attempts": 3,
    "known_provider_task_is_queried_not_recreated": true,
    "unknown_provider_state_forbids_new_attempt": true,
    "new_key_requires_deliberate_new_user_intent": true,
    "outputs_are_short_lived_and_sha256_verified": true
  },
  "skill_routes": {
    "onion-demand-report": {
      "tools": [
        "intelligence_freeze_report_input",
        "intelligence_list_report_availability",
        "intelligence_get_report_scope",
        "intelligence_list_demand_evidence",
        "intelligence_get_analysis_evidence",
        "intelligence_get_material_detail"
      ]
    },
    "onion-creative-report": {
      "tools": [
        "intelligence_freeze_report_input",
        "intelligence_list_report_availability",
        "intelligence_get_report_scope",
        "intelligence_list_creative_evidence",
        "intelligence_get_material_detail",
        "intelligence_get_analysis_evidence"
      ]
    },
    "onion-internal-demand-report": {
      "tools": [
        "intelligence_freeze_report_input",
        "intelligence_list_report_availability",
        "intelligence_list_internal_complete_material_pool",
        "intelligence_list_internal_material_evidence",
        "intelligence_search_internal_objects"
      ]
    },
    "onion-internal-creative-report": {
      "tools": [
        "intelligence_freeze_report_input",
        "intelligence_list_report_availability",
        "intelligence_list_internal_complete_material_pool",
        "intelligence_list_internal_material_evidence",
        "intelligence_search_internal_objects"
      ]
    },
    "onion-app-video-copy": {
      "tools": ["generation_kimi_generate", "generation_get_operation"]
    },
    "onion-lead-video-copy": {
      "tools": ["generation_kimi_generate", "generation_get_operation"]
    },
    "onion-app-image": {
      "tools": ["generation_upload_media", "generation_kie_image", "generation_get_operation", "generation_get_output"]
    },
    "onion-voiceover-video-mix": {
      "required_retrieval_mode": "hybrid",
      "tools": [
        "generation_moss_tts",
        "generation_qwen_asr",
        "generation_upload_media",
        "materials_search_segments",
        "materials_get_segments",
        "materials_prepare_sources",
        "generation_render_voiceover_video",
        "generation_get_operation",
        "generation_get_output"
      ]
    },
    "onion-talking-head-video-mix": {
      "required_retrieval_mode": "hybrid",
      "tools": [
        "materials_search_speech_masters",
        "materials_get_speech_master",
        "materials_search_segments",
        "materials_get_segments",
        "materials_prepare_sources",
        "generation_upload_media",
        "generation_render_talking_head_video",
        "generation_get_operation",
        "generation_get_output"
      ]
    }
  }
}
